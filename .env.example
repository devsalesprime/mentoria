# Prosperus Mentoria Platform — Environment Variables
# Copy this file to .env and fill in the values

# HubSpot CRM Integration
HUBSPOT_PRIVATE_TOKEN=your-hubspot-private-app-token
HUBSPOT_WIN_STAGE=closedwon

# Server
PORT=3005
NODE_ENV=development

# Authentication (REQUIRED — server will not start without JWT_SECRET)
# Generate JWT_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Generate hash: node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
ADMIN_PASSWORD_HASH=

# Google AI (Gemini)
GEMINI_APIKEY=your-gemini-api-key

# Fila do Script 7 Passos (worker externo: a Naia, no VPS)
# Token que o worker manda em "Authorization: Bearer <token>" nas rotas /api/jobs/*.
# Vazio = fila desligada (todas as rotas /api/jobs/* respondem 503). Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COHORT_JOBS_TOKEN=
# Opcional: URL publica do app, devolvida ao worker em POST /api/jobs/next (app_url). Sem ela, usa o host da requisicao.
APP_URL=

# Transcricao de audio do contexto por campo (Groq whisper): POST /api/script/context com tipo=audio.
# Vazio = o audio e guardado sem transcricao (o item recebe erro_transcricao e a resposta traz um aviso).
GROQ_API_KEY=
